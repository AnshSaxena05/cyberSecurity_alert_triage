# Architecture-2 BFF environment.

# -----------------------------------------------------------------------------
# Where the BFF reaches the backend services.
# -----------------------------------------------------------------------------
# FastAPI ingest:
SOC_API_BASE_URL=http://localhost:8000

# NATS (used for auth.revocations broadcast on logout):
NATS_URL=nats://localhost:4222

# Redis (sessions + ws ticket store):
REDIS_URL=redis://localhost:6379/0

# Postgres (users + service_secrets):
POSTGRES_URL=postgresql://soc:soc@localhost:5432/soc_checkpoint

# -----------------------------------------------------------------------------
# Token lifetimes (don't shorten access TTL much further; long LLM streams
# rely on a refresh-during-stream not happening every 30 s).
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900       # 15 min
REFRESH_TOKEN_TTL_SECONDS=604800   # 7 days
WS_TICKET_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Cookie scope. In production, set NEXT_PUBLIC_DOMAIN to the eTLD+1 your
# browser app runs on so the refresh-token cookie scope is correct.
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                # set true behind HTTPS

# -----------------------------------------------------------------------------
# Logout / live-WS revocation. The fan-out subscribes here and pushes a
# `revoked` envelope to every DO belonging to the user.
# -----------------------------------------------------------------------------
REVOCATION_SUBJECT_PREFIX=auth.revocations.v1
