# SOC Triage Agent — Environment Configuration
# Copy to .env and fill in your values

# ------------------------------------------------------------------ #
# Application
# ------------------------------------------------------------------ #
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=change-me-in-production

# HTTP timeout (seconds) for tool APIs and scripts/test_connector_creds.py
TOOL_TIMEOUT_SECONDS=30

# POST /ingest/auto: when vendor cannot be inferred, call FAST_MODEL to flatten JSON into title/description/severity (set false for strict offline-only ingest)
AUTO_INGEST_COERCE_LLM=true

# ------------------------------------------------------------------ #
# Ollama (local LLM)
# ------------------------------------------------------------------ #
OLLAMA_BASE_URL=http://localhost:11434
DEEP_MODEL=axonvertex/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:Q8_0_24K
FAST_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=8192

# ------------------------------------------------------------------ #
# OpenAI fallback (used when local Ollama model is unavailable)
# ------------------------------------------------------------------ #
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ------------------------------------------------------------------ #
# Redis cache
# ------------------------------------------------------------------ #
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------ #
# Splunk
# ------------------------------------------------------------------ #
SPLUNK_HOST=splunk.yourcompany.com
SPLUNK_PORT=8089
SPLUNK_TOKEN=your-splunk-hec-token

# ------------------------------------------------------------------ #
# CrowdStrike Falcon
# ------------------------------------------------------------------ #
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com

# ------------------------------------------------------------------ #
# AWS
# ------------------------------------------------------------------ #
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------------ #
# ServiceNow ITSM / CMDB
# ------------------------------------------------------------------ #
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# ------------------------------------------------------------------ #
# Threat Intelligence
# ------------------------------------------------------------------ #
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ------------------------------------------------------------------ #
# VulnCheck (vulnerability / CVE enrichment)
# ------------------------------------------------------------------ #
VULNCHECK_API_TOKEN=

# ------------------------------------------------------------------ #
# LangSmith (optional — set LANGCHAIN_TRACING_V2=true to enable)
# ------------------------------------------------------------------ #
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=soc-triage-agent

# ------------------------------------------------------------------ #
# Langfuse (optional — set LANGFUSE_ENABLED=true to enable)
# API keys are region-specific. LANGFUSE_BASE_URL MUST match where the project
# lives or traces never appear in the UI (OTLP often returns 401).
#   EU: https://cloud.langfuse.com
#   US: https://us.cloud.langfuse.com   ← use if your URL is us.cloud.langfuse.com/...
# ------------------------------------------------------------------ #
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PROMPT_MANAGEMENT=false

# ------------------------------------------------------------------ #
# Alert / verdict persistence (optional — same REDIS_URL as cache)
# ------------------------------------------------------------------ #
# When true, alerts, verdicts, and job status are stored in Redis and survive restarts.
VERDICT_PERSISTENCE_ENABLED=false

# ------------------------------------------------------------------ #
# Async integrations (optional)
# ------------------------------------------------------------------ #
# POST JSON { alert_id, verdict } when triage completes successfully (empty = disabled)
TRIAGE_COMPLETE_WEBHOOK_URL=

# NetFlow / NDR HTTP bridge — query_netflow POSTs here when set
NDR_FLOW_API_URL=
NDR_FLOW_API_TOKEN=

# Backup vendor HTTP bridge — query_backup_systems POSTs here when set
BACKUP_API_URL=
BACKUP_API_TOKEN=
